  "rules": [
    {
      "road_slug": "meta-discipline",
      "severity": "INFO",
      "category": "quality",
      "rule": "Query Code Brain before implementing a cross-cutting pattern. Do not infer the standard from existing app code — that code may predate the standard.",
      "reason": "Code Brain is the source of record for paved-road patterns. Inferring from existing code reproduces drift the registry exists to remove.",
      "source": "code-brain-spec.md (lifted from Infra Brain #14)"
    },
    {
      "road_slug": "meta-discipline",
      "severity": "INFO",
      "category": "quality",
      "rule": "Write back to Code Brain when a cross-cutting pattern is decided or a lesson is learned.",
      "reason": "The registry only stays current if agents and humans update it. A stale registry is worse than no registry.",
      "source": "code-brain-spec.md (lifted from Infra Brain #15)"
    }
  ]
