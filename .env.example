# Brain type — one of: infra, open, app
BRAIN_TYPE=infra

# MCP auth key — must be exactly 64 lowercase hex characters
# Example: generate with: python -c "import secrets; print(secrets.token_hex(32))"
MCP_ACCESS_KEY=replace_with_64_lowercase_hex_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database connection (use POSTGRES_HOST=db when running via docker-compose.local.yml)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=brain
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=brain

# OpenRouter API key — required for open and app brain types (uses embeddings)
# Not needed for infra brain (embeddings=False)
OPENROUTER_API_KEY=sk-or-v1-replace_with_real_key

# Logging and environment
LOG_LEVEL=INFO
APP_ENV=development
